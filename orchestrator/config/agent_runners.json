{
  "claude": {
    "binary": "claude",
    "args": [
      "--dangerously-skip-permissions",
      "--model",
      "{model}",
      "-p",
      "{prompt_text}"
    ]
  },
  "gemini": {
    "binary": "gemini",
    "args": [
      "--approval-mode",
      "yolo",
      "-m",
      "{model}",
      "-p",
      "{prompt_text}"
    ]
  },
  "codex": {
    "binary": "codex",
    "args": [
      "--model",
      "{model}",
      "--prompt-file",
      "{prompt_file}"
    ]
  }
}
